QScrollBar:vertical {
  width: 10px;
}

QPushButton#SendButton {
    background-color: {{ colors.base }};
    border: 2px solid {{ colors.link }};

    border-radius: 16px;

    font-size: 16px;
    font-weight: bold;
}

QPushButton#SendButton:hover {
    border: 2px solid {{ colors.link }};
    background-color: {{ colors.link }};
}

QPushButton#SendButton:pressed {
    background-color: {{ colors.link }};
}

QTextEdit {
    background-color: {{ colors.base }};
    color: {{ colors.text }};
    border: 1px solid {{ colors.midlight }};
    border-radius: 16px;
    padding: 8px;
    font-size: {{ fontstyles.size }}pt;
}
