

QLineEdit#SearchInput {
    background-color: {{ colors.base }};
    color: {{ colors.text }};
    border: 1px solid {{ colors.midlight }};
    font-size: {{ fontstyles.size }}pt;
    font-family: "{{ fontstyles.family }}";
}

QLabel#SearchCount {
    color: {{ colors.text }};
    font-size: {{ fontstyles.size }}pt;
    font-family: "{{ fontstyles.family }}";
    padding: 0 2px;
}

QPushButton#SearchPrevButton,
QPushButton#SearchNextButton,
QPushButton#SearchCloseButton {
    background-color: transparent;
    color: {{ colors.text }};
    font-size: {{ fontstyles.size }}pt;
    font-family: "{{ fontstyles.family }}";
    padding: 1px;
}
