{# themes.qss.jinja #}
/* ================================================================= */
/* THEME REGISTRY MAP                                                */
/* ================================================================= */
{% set registry = {
    "dark": {
        "bg_main":   "#1e1e1e",
        "bg_input":  "#252526",
        "bg_tool":   "#1a1a24",
        "text_main": "#ffffff",
        "text_tool": "#50fa7b",
        "border":    "#3e3e42",
        "accent":    "#007acc"
    },
    "light": {
        "bg_main":   "#ffffff",
        "bg_input":  "#f3f3f3",
        "bg_tool":   "#f0f4f8",
        "text_main": "#000000",
        "text_tool": "#006600",
        "border":    "#b4b4b4",
        "accent":    "#007acc"
    }
} %}

/* Look up the chosen theme profile. Fallback to 'dark' if invalid.  */
{% set c = registry[theme] if theme in registry else registry["light"] %}