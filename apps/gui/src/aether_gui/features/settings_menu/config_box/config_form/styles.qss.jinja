QGroupBox[settingsRole="section"] {
    border: {{ tokens.border_width }} solid {{ colors.mid }};
    border-radius: {{ tokens.radius_section }};
    margin-top: {{ tokens.margin_group_top }};
    padding: {{ tokens.pad_group }};
    font-family: "{{ fontstyles.family }}";
    font-size: {{ fontstyles.size }}pt;
    font-weight: bold;
}

QGroupBox[settingsRole="section"]::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: {{ tokens.title_left }};
    padding: {{ tokens.pad_title }};
    color: {{ colors.text }};
}

QLabel[settingsRole="title"] {
    color: {{ colors.text }};
    font-family: "{{ fontstyles.family }}";
    font-size: {{ fontstyles.size }}pt;
    font-weight: bold;
}

QLabel[settingsRole="description"] {
    color: {{ colors.placeholdertext }};
    font-family: "{{ fontstyles.family }}";
    font-size: {{ fontstyles.size }}pt;
    font-weight: {{ fontstyles.weight }};
}

QLineEdit, QPlainTextEdit {
    background-color: {{ colors.base }};
    color: {{ colors.text }};
    border: {{ tokens.border_width }} solid {{ colors.midlight }};
    border-radius: {{ tokens.radius_input }};
    padding: {{ tokens.pad_input }};
    font-family: "{{ fontstyles.family }}";
    font-size: {{ fontstyles.size }}pt;
    font-weight: {{ fontstyles.weight }};
}

QLineEdit:focus, QPlainTextEdit:focus {
    border: {{ tokens.border_width }} solid {{ colors.highlight }};
}

QCheckBox {
    color: {{ colors.text }};
    font-family: "{{ fontstyles.family }}";
    font-size: {{ fontstyles.size }}pt;
    font-weight: {{ fontstyles.weight }};
}
