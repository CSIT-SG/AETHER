QGroupBox[settingsRole="section"] {
    border: 1px solid {{ colors.mid }};
    border-radius: 6px;
    margin-top: 14px;
    padding: 8px;
    font-family: "{{ fontstyles.family }}";
    font-size: {{ fontstyles.size }}pt;
    font-weight: bold;
}

QGroupBox[settingsRole="section"]::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    color: {{ colors.text }};
}

QLabel[settingsRole="title"] {
    color: {{ colors.text }};
    font-family: "{{ fontstyles.family }}";
    font-size: {{ fontstyles.size }}pt;
    font-weight: bold;
}

QLabel[settingsRole="description"] {
    color: {{ colors.placeholdertext }};
    font-family: "{{ fontstyles.family }}";
    font-size: {{ fontstyles.size }}pt;
    font-weight: {{ fontstyles.weight }};
}

QLabel[settingsRole="required"] {
    color: {{ colors.error }};
    font-family: "{{ fontstyles.family }}";
    font-size: {{ fontstyles.size }}pt;
    font-weight: {{ fontstyles.weight }};
}

QLineEdit, QPlainTextEdit {
    background-color: {{ colors.base }};
    color: {{ colors.text }};
    border: 1px solid {{ colors.midlight }};
    border-radius: 4px;
    padding: 4px;
    font-family: "{{ fontstyles.family }}";
    font-size: {{ fontstyles.size }}pt;
    font-weight: {{ fontstyles.weight }};
}

QLineEdit:focus, QPlainTextEdit:focus {
    border: 1px solid {{ colors.highlight }};
}

QCheckBox {
    color: {{ colors.text }};
    font-family: "{{ fontstyles.family }}";
    font-size: {{ fontstyles.size }}pt;
    font-weight: {{ fontstyles.weight }};
}

/* Small buttons sitting to the right of a field's control (show/hide, Check). */
QPushButton#FieldButton {
    background-color: {{ colors.button }};
    color: {{ colors.buttontext }};
    border: 1px solid {{ colors.mid }};
    border-radius: 4px;
    padding: 4px 10px;
    font-family: "{{ fontstyles.family }}";
    font-size: {{ fontstyles.size }}pt;
    font-weight: bold;
}

QPushButton#FieldButton:hover {
    border: 1px solid {{ colors.highlight }};
}

QPushButton#FieldButton:disabled {
    color: {{ colors.placeholdertext }};
}

/* Inline API-key check result, coloured from the theme's semantic colours. */
QLabel[messageState="error"],
QLabel[messageState="success"],
QLabel[messageState="none"] {
    font-family: "{{ fontstyles.family }}";
    font-size: {{ fontstyles.size }}pt;
    font-weight: {{ fontstyles.weight }};
}

QLabel[messageState="error"] {
    color: {{ colors.error }};
}

QLabel[messageState="success"] {
    color: {{ colors.success }};
}

QLabel[messageState="none"] {
    color: {{ colors.placeholdertext }};
}
