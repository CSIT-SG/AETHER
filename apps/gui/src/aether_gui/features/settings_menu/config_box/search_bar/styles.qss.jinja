QLineEdit#SettingsSearch {
    background-color: {{ colors.base }};
    color: {{ colors.text }};
    border: {{ tokens.border_width }} solid {{ colors.midlight }};
    border-radius: {{ tokens.radius_input }};
    padding: {{ tokens.pad_search }};
    margin: {{ tokens.margin_search }};
    font-family: "{{ fontstyles.family }}";
    font-size: {{ fontstyles.size }}pt;
    font-weight: {{ fontstyles.weight }};
}

QLineEdit#SettingsSearch:focus {
    border: {{ tokens.border_width }} solid {{ colors.highlight }};
}

QLabel#SettingsCount {
    color: {{ colors.placeholdertext }};
    padding: {{ tokens.pad_count }};
    font-family: "{{ fontstyles.family }}";
    font-size: {{ fontstyles.size }}pt;
    font-weight: {{ fontstyles.weight }};
}

QPushButton#JsonToggle, QPushButton#JsonBack {
    background-color: {{ colors.button }};
    color: {{ colors.buttontext }};
    border: {{ tokens.border_width }} solid {{ colors.mid }};
    border-radius: {{ tokens.radius_input }};
    padding: {{ tokens.pad_button }};
    font-family: "{{ fontstyles.family }}";
    font-size: {{ fontstyles.size }}pt;
    font-weight: bold;
}

QPushButton#JsonToggle:hover, QPushButton#JsonBack:hover {
    border: {{ tokens.border_width }} solid {{ colors.highlight }};
}
